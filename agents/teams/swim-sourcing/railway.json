{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r agents/teams/swim-sourcing/requirements.txt"
  },
  "deploy": {
    "startCommand": "python agents/teams/swim-sourcing/worker.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
