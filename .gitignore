# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# MCP config — contains API keys and secrets; never commit
# Copy .mcp.json.example → .mcp.json and fill in real values
.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude worktrees — local only, never commit
.claude/worktrees/
# Claude Code local machine settings — never commit
.claude/settings.local.json

# python
__pycache__/
*.pyc

# local data
.codex/
agents/instances/*/outputs/
outputs/
session-logs/
*.log

# Session guardian runtime files — local only
.claude/guardian.pid
.claude/checkpoint.log
.claude/.limit_checkpoint_done
